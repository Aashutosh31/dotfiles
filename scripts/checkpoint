#!/usr/bin/env bash
#
# checkpoint — one-command state snapshot for this Omarchy desktop.
#
# Three layers, because one is not enough:
#
#   1. configs   ~/.dotfiles-backup/<ts>/home  + meta/     (always, no root)
#      The files this repo owns and the desktop actually reads. ~29 MB.
#
#   2. system    omarchy snapshot create                    (TTY only)
#      Root btrfs snapshot via snapper, exposed in the Limine boot menu.
#      Protected against a broken boot, but note: snapper is configured for
#      SUBVOLUME="/" only, so it does NOT cover /home.
#
#   3. home      read-only btrfs snapshot of /home          (--full only)
#      The literal "everything" layer. CoW, so it is instant and costs
#      almost nothing until the two states diverge.
#
# Usage:
#   checkpoint [--full] [--label NAME] [--no-system]
#   checkpoint list
#   checkpoint verify [<ts|latest>]
#   checkpoint undo   [<ts|latest>]
#   checkpoint prune  [COUNT]
#
# Environment:
#   CHECKPOINT_ROOT   where config snapshots live
#                     (default: ~/.dotfiles-backup)
#   CHECKPOINT_KEEP   how many config snapshots prune keeps (default: 15)

set -euo pipefail

ROOT="${CHECKPOINT_ROOT:-$HOME/.dotfiles-backup}"
KEEP="${CHECKPOINT_KEEP:-15}"
HOME_SNAP_ROOT="/.snapshots-home"

# Everything this repo touches that the desktop reads at runtime. Deliberately
# explicit: ~/.config is 8.7 GB of browser and editor profiles we must not copy.
SCOPE=(
  .config/hypr
  .config/omarchy
  .config/ghostty
  .config/zellij
  .config/tmux
  .config/btop
  .config/nvim
  .config/yazi
  .config/fish
  .config/starship.toml
  .local/bin/checkpoint
  .local/bin/cyberdeck
  .local/state/omarchy/toggles
)

# Hyprland options this project changes. Captured so "is it really reverted?"
# is checkable instead of a feeling.
OPTIONS=(
  general:gaps_in
  general:gaps_out
  general:border_size
  decoration:rounding
  decoration:active_opacity
  decoration:inactive_opacity
  decoration:dim_inactive
  decoration:dim_strength
  decoration:blur:enabled
  decoration:blur:size
  decoration:blur:passes
  decoration:blur:xray
  animations:enabled
)

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '\033[32m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }
die()  { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }
on_tty() { [[ -t 0 ]]; }

# Sorted, relative-path sha256 listing of SCOPE under a base directory.
hash_scope() {
  local base="$1" rel existing=()
  for rel in "${SCOPE[@]}"; do
    [[ -e "$base/$rel" ]] && existing+=("$rel")
  done
  (( ${#existing[@]} )) || return 0
  (
    cd "$base"
    find "${existing[@]}" -type f -print0 \
      | LC_ALL=C sort -z \
      | xargs -0 -r sha256sum \
      | LC_ALL=C sort
  )
}

# Newest checkpoint directory that this tool created.
latest_checkpoint() {
  local d
  for d in $(find "$ROOT" -maxdepth 1 -mindepth 1 -type d -printf '%f\n' 2>/dev/null \
               | LC_ALL=C sort -r); do
    if [[ -f "$ROOT/$d/meta/manifest.txt" ]]; then
      printf '%s\n' "$ROOT/$d"
      return 0
    fi
  done
  return 1
}

resolve_checkpoint() {
  local want="${1:-latest}"
  if [[ "$want" == "latest" ]]; then
    latest_checkpoint || die "No checkpoints yet in $ROOT"
    return 0
  fi
  local dir="$ROOT/$want"
  [[ -d "$dir" ]] || dir="$want"
  [[ -d "$dir" ]] || die "No such checkpoint: $want"
  [[ -f "$dir/meta/manifest.txt" ]] || die "Not a checkpoint (missing meta/manifest.txt): $dir"
  printf '%s\n' "$dir"
}

# ---------------------------------------------------------------------------
# create
# ---------------------------------------------------------------------------
cmd_create() {
  local label="" want_system="auto" want_home=0
  while (( $# )); do
    case "$1" in
      --full)      want_home=1 ;;
      --system)    want_system="yes" ;;
      --no-system) want_system="no" ;;
      --label)     shift; label="${1:-}" ;;
      -h|--help)   usage; exit 0 ;;
      *)           die "Unknown argument: $1" ;;
    esac
    shift
  done

  # Keep labels filesystem-safe without letting them break sort order.
  label="${label//[^A-Za-z0-9._-]/_}"
  [[ "$label" == "pre-undo" || "$label" == "pre-restore" ]] && label="manual-$label"

  local ts dest
  ts="$(date +%Y%m%d-%H%M%S)"
  dest="$ROOT/$ts${label:+-$label}"
  [[ -e "$dest" ]] && die "Checkpoint already exists: $dest"

  mkdir -p "$dest/home" "$dest/meta"

  # If anything fails midway, leave no half-checkpoint behind: prune and undo
  # both key off meta/manifest.txt, so a partial dir would just be litter.
  # shellcheck disable=SC2064
  trap "rm -rf '$dest'" ERR

  bold "Capturing configs → $dest"
  local rel src absent=0
  : >"$dest/meta/absent.txt"
  for rel in "${SCOPE[@]}"; do
    src="$HOME/$rel"
    if [[ -e "$src" ]]; then
      mkdir -p "$dest/home/$(dirname "$rel")"
      cp -a "$src" "$dest/home/$(dirname "$rel")/"
    else
      printf '%s\n' "$rel" >>"$dest/meta/absent.txt"
      absent=$((absent + 1))
    fi
  done
  ok "  $(du -sh "$dest/home" | cut -f1) captured, $absent path(s) absent"

  # --- manifest ------------------------------------------------------------
  {
    echo "timestamp:     $(date -Is)"
    echo "host:          $(uname -n)"
    echo "kernel:        $(uname -r)"
    echo "label:         ${label:-none}"
    have omarchy && echo "omarchy:       $(omarchy version 2>/dev/null | head -1)"
    if have git && [[ -d "$HOME/dotfiles/.git" ]]; then
      echo "dotfiles_rev:  $(git -C "$HOME/dotfiles" rev-parse HEAD 2>/dev/null)"
      local dirty
      dirty="$(git -C "$HOME/dotfiles" status --porcelain 2>/dev/null | wc -l)"
      echo "dotfiles_dirty: $dirty file(s)"
    fi
    echo "scope:"
    printf '  %s\n' "${SCOPE[@]}"
  } >"$dest/meta/manifest.txt"

  hash_scope "$dest/home" >"$dest/meta/files.sha256"

  if have hyprctl && pgrep -x Hyprland >/dev/null 2>&1; then
    : >"$dest/meta/options.txt"
    local opt
    for opt in "${OPTIONS[@]}"; do
      printf '%s = %s\n' "$opt" \
        "$(hyprctl getoption "$opt" 2>/dev/null | head -1)" >>"$dest/meta/options.txt"
    done
  fi

  if have snapper; then
    sudo -n snapper --csvout list >"$dest/meta/snapper.csv" 2>/dev/null || true
  fi

  # --- git tag, so the tracked half is one command away -------------------
  if have git && [[ -d "$HOME/dotfiles/.git" ]]; then
    if git -C "$HOME/dotfiles" tag "checkpoint/$ts" >/dev/null 2>&1; then
      ok "  tagged checkpoint/$ts"
    else
      warn "  could not tag checkpoint/$ts (already exists?)"
    fi
  fi

  # --- system layer -------------------------------------------------------
  if [[ "$want_system" == "no" ]]; then
    warn "System snapshot skipped (--no-system)."
  elif ! on_tty; then
    warn "System snapshot skipped (no TTY for the sudo prompt)."
    warn "Run 'omarchy snapshot create' or press Super+Ctrl+Shift+S from a terminal."
  elif have omarchy; then
    echo
    bold "Creating root snapshot (bootable via Limine)…"
    if omarchy snapshot create; then
      ok "  root snapshot created"
    else
      warn "  root snapshot failed — config layer is still intact"
    fi
  else
    warn "omarchy not found; skipping root snapshot."
  fi

  # --- home layer ---------------------------------------------------------
  if (( want_home )); then
    if ! on_tty; then
      warn "Home snapshot skipped (no TTY for the sudo prompt)."
    elif ! have btrfs; then
      warn "btrfs not found; skipping home snapshot."
    else
      echo
      bold "Snapshotting /home (read-only, CoW)…"
      if sudo install -d -m 0750 "$HOME_SNAP_ROOT" &&
         sudo btrfs subvolume snapshot -r /home "$HOME_SNAP_ROOT/$ts"; then
        ok "  /home → $HOME_SNAP_ROOT/$ts"
        echo "home_snapshot: $HOME_SNAP_ROOT/$ts" >>"$dest/meta/manifest.txt"
      else
        warn "  home snapshot failed — config layer is still intact"
      fi
    fi
  fi

  trap - ERR
  echo
  ok "Checkpoint: $dest"
  echo "  undo with: checkpoint undo $ts"
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------
cmd_list() {
  [[ -d "$ROOT" ]] || die "No checkpoints yet ($ROOT does not exist)."

  bold "Config checkpoints in $ROOT"
  local found=0 d name size sys
  while IFS= read -r d; do
    found=1
    name="$(basename "$d")"
    size="$(du -sh "$d/home" 2>/dev/null | cut -f1)"
    sys="$(grep -c '^' "$d/meta/files.sha256" 2>/dev/null || echo 0)"
    printf '  %-28s %6s  %5s file(s)\n' "$name" "$size" "$sys"
  done < <(find "$ROOT" -maxdepth 1 -mindepth 1 -type d -printf '%p\n' 2>/dev/null \
             | while read -r d; do
                 [[ -f "$d/meta/manifest.txt" ]] && printf '%s\n' "$d"
               done | LC_ALL=C sort -r)

  (( found )) || echo "  (none)"

  if have snapper; then
    local snap
    snap="$(sudo -n snapper --csvout list 2>/dev/null || true)"
    if [[ -n "$snap" ]]; then
      echo
      bold "Snapper snapshots"
      printf '%s\n' "$snap" | awk -F, 'NR>1 {printf "  #%-4s %-22s %s\n", $1, $4, substr($0, index($0,$5))}'
    fi
  fi

  if [[ -d "$HOME_SNAP_ROOT" ]]; then
    echo
    bold "Home snapshots in $HOME_SNAP_ROOT"
    find "$HOME_SNAP_ROOT" -maxdepth 1 -mindepth 1 -printf '  %f\n' 2>/dev/null | LC_ALL=C sort -r \
      || echo "  (not readable without root)"
  fi
}

# ---------------------------------------------------------------------------
# verify
# ---------------------------------------------------------------------------
cmd_verify() {
  local snap; snap="$(resolve_checkpoint "${1:-latest}")"
  local live; live="$(mktemp)"
  hash_scope "$HOME" >"$live"

  if diff -u "$snap/meta/files.sha256" "$live" >/dev/null 2>&1; then
    ok "Live config matches $(basename "$snap") exactly."
    rm -f "$live"
    return 0
  fi

  warn "Live config differs from $(basename "$snap"):"
  diff -u "$snap/meta/files.sha256" "$live" \
    | sed -e '1,2d' -e 's/^/  /' | head -40
  rm -f "$live"
  return 1
}

# ---------------------------------------------------------------------------
# undo
# ---------------------------------------------------------------------------
cmd_undo() {
  local snap; snap="$(resolve_checkpoint "${1:-latest}")"
  local ts; ts="$(basename "$snap")"

  echo "Restoring from $ts"
  echo

  # Make the undo itself undoable. Configs only: no prompt, no waiting.
  bold "Safety checkpoint of the current state…"
  CHECKPOINT_ROOT="$ROOT" cmd_create --no-system --label pre-undo >/dev/null
  ok "  saved as $(basename "$(latest_checkpoint)")"

  local rel src absent_file="$snap/meta/absent.txt"
  for rel in "${SCOPE[@]}"; do
    src="$snap/home/$rel"
    if [[ -d "$src" ]]; then
      mkdir -p "$HOME/$rel"
      rsync -a --delete "$src/" "$HOME/$rel/"
      printf '  restored %s\n' "$rel"
    elif [[ -f "$src" ]]; then
      mkdir -p "$HOME/$(dirname "$rel")"
      cp -a "$src" "$HOME/$rel"
      printf '  restored %s\n' "$rel"
    elif [[ -f "$absent_file" ]] && grep -qxF "$rel" "$absent_file"; then
      if [[ -e "$HOME/$rel" ]]; then
        rm -rf "${HOME:?}/$rel"
        printf '  removed  %s (absent in checkpoint)\n' "$rel"
      fi
    else
      warn "  skipped $rel (not part of this checkpoint)"
    fi
  done

  echo
  bold "Reloading session…"
  if have hyprctl && pgrep -x Hyprland >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || warn "  hyprctl reload failed"
    local errors
    errors="$(hyprctl configerrors 2>/dev/null || true)"
    if [[ -n "$errors" ]]; then
      warn "  Hyprland reports config errors after restore:"
      printf '%s\n' "$errors" | sed 's/^/    /'
      exit 1
    fi
    ok "  Hyprland reloaded, no config errors"
  fi

  echo "  New terminal windows pick up the restored terminal configs."
  echo
  cmd_verify "$snap" || true
  echo

  if have omarchy; then
    if omarchy restart shell >/dev/null 2>&1; then
      ok "  Omarchy shell restarted"
    else
      warn "  Omarchy shell restart failed (bar may need 'omarchy restart shell')"
    fi
  fi
}

# ---------------------------------------------------------------------------
# prune
# ---------------------------------------------------------------------------
cmd_prune() {
  local keep="${1:-$KEEP}" count=0 d
  [[ "$keep" =~ ^[0-9]+$ ]] || die "prune wants a number, got: $keep"
  [[ -d "$ROOT" ]] || { ok "Nothing to prune."; return 0; }

  while IFS= read -r d; do
    count=$((count + 1))
    if (( count > keep )); then
      rm -rf "$d"
      printf '  removed %s\n' "$(basename "$d")"
    fi
  done < <(find "$ROOT" -maxdepth 1 -mindepth 1 -type d -printf '%p\n' 2>/dev/null \
             | while read -r d; do
                 [[ -f "$d/meta/manifest.txt" ]] && printf '%s\n' "$d"
               done | LC_ALL=C sort -r)

  ok "Kept the newest $keep checkpoint(s)."
}

usage() {
  sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  local cmd="create"
  # --pause is global: used by the hotkey so the terminal window stays open
  # long enough to read the result (and to hold the sudo prompt).
  PAUSE=0
  local args=()
  local a
  for a in "$@"; do
    if [[ "$a" == "--pause" ]]; then PAUSE=1; else args+=("$a"); fi
  done
  set -- ${args[@]+"${args[@]}"}

  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help|help)  usage; exit 0 ;;
      create|snapshot) cmd="create"; shift ;;
      list|ls)         cmd="list"; shift ;;
      verify|diff)     cmd="verify"; shift ;;
      undo|restore)    cmd="undo"; shift ;;
      prune)           cmd="prune"; shift ;;
      -*)              : ;;  # a leading flag means the default command
      *)               die "Unknown command: $1 (try: checkpoint help)" ;;
    esac
  fi

  case "$cmd" in
    create) cmd_create "$@" ;;
    list)   cmd_list "$@" ;;
    verify) cmd_verify "$@" ;;
    undo)   cmd_undo "$@" ;;
    prune)  cmd_prune "$@" ;;
  esac

  if (( PAUSE )); then
    echo
    read -n 1 -s -r -p "Press any key to close…" || true
    echo
  fi
}

main "$@"
