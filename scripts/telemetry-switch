#!/usr/bin/env bash
set -euo pipefail

case "${1:-telemetry}" in
  telemetry) wanted="aashutosh31.telemetry" ;;
  cpu|current) wanted="aashutosh31.cpu" ;;
  *) echo "Usage: telemetry-switch [telemetry|cpu]" >&2; exit 2 ;;
esac

omarchy plugin enable "$wanted" >/dev/null
omarchy bar put "$wanted" --section right >/dev/null
python3 - "$wanted" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

wanted = sys.argv[1]
path = Path.home() / ".config/omarchy/shell.json"
data = json.loads(path.read_text())
for section in data["bar"]["layout"].values():
    if isinstance(section, list):
        section[:] = [entry for entry in section if entry.get("id") not in {"aashutosh31.cpu", "aashutosh31.telemetry"} or entry.get("id") == wanted]
path.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
PY
omarchy restart shell >/dev/null
printf 'Bar switched to %s.\n' "$wanted"
